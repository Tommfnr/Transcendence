meta {
  name: 25 update member role to member
  type: http
  seq: 25
}

patch {
  url: https://pep.localhost:8443/api/groups/{{group_id}}/members/{{u2_id}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "role": "member"
  }
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`update member role (member) failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
