meta {
  name: create group Neighbors
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u3_token}}
}

body:json {
  {
    "name": "Neighbors",
    "description": "Sharing tools and equipment with people nearby."
  }
}

script:post-response {
  const json = res.getBody();

  if (res.getStatus() !== 201)
    throw new Error(`create group Neighbors failed: ${res.getStatus()} ${JSON.stringify(json)}`);

  bru.setEnvVar('neighbors_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
