meta {
  name: login noah_silva
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "noah_silva",
    "password": "Noah2024!"
  }
}

script:post-response {
  const json = res.getBody();
  
  if (res.getStatus() !== 200)
    throw new Error(`login noah_silva failed: ${res.getStatus()} ${JSON.stringify(json)}`);
  
  bru.setEnvVar('u4_token', json.access_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
