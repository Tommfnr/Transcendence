meta {
  name: create post Sewing Machine Wanted
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u5_token}}
}

body:json {
  {
    "title": "Sewing Machine Wanted",
    "objectType": "Electronics",
    "description": "Need a sewing machine to hem some curtains.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{friends_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Sewing Machine Wanted failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
