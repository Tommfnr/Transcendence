meta {
  name: 45 remove user U1
  type: http
  seq: 45
}

delete {
  url: https://pep.localhost:8443/api/users/{{u1_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 204)
    throw new Error(`remove user U1 failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
