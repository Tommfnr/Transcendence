meta {
  name: create object Mountain Bike
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_token}}
}

body:json {
  {
    "name": "Mountain Bike",
    "type": "Vehicles",
    "description": "Aluminum frame mountain bike, 21-speed, recently serviced.",
    "condition": "good",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object Mountain Bike failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
