meta {
  name: add liam_chen to Friends
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/groups/{{friends_id}}/members/{{u2_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u5_token}}
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`add liam_chen to Friends failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
