meta {
  name: create post Stand Mixer Needed
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_token}}
}

body:json {
  {
    "title": "Stand Mixer Needed",
    "objectType": "Electronics",
    "description": "Looking for a stand mixer to bake for the school fundraiser this weekend.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{family_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Stand Mixer Needed failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
