meta {
  name: 14 find one object
  type: http
  seq: 14
}

get {
  url: https://pep.localhost:8443/api/objects/{{object_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find one object failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
