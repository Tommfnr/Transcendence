meta {
  name: create post Camping Tent Needed
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_token}}
}

body:json {
  {
    "title": "Camping Tent Needed",
    "objectType": "Outdoor & Recreation",
    "description": "Looking for a camping tent for a family trip next month.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{family_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Camping Tent Needed failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
