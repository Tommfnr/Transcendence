meta {
  name: signIn #U2 (username)
  type: http
  seq: 7
}

post {
  url: https://pep.localhost:8443/api/auth/login/
  body: json
  auth: inherit
}

body:json {
  {
      "identifier": "louis",
      "password": "1ouisLeBlo@t"
  }
}

script:post-response {
  const responseText = JSON.stringify(res.getBody());
  let json;
  
  try {
      json = JSON.parse(responseText);
      bru.setEnvVar('access_token', json.access_token);
      bru.setEnvVar('refresh_token', json.refresh_token);
      bru.setGlobalEnvVar('access_token', json.access_token);
      bru.setGlobalEnvVar('refresh_token', json.refresh_token);
  } catch (e) {
      console.error("Failed to parse JSON:", e);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
