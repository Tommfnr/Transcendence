meta {
  name: 42 delete object
  type: http
  seq: 42
}

delete {
  url: https://pep.localhost:8443/api/objects/{{object_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 204)
    throw new Error(`delete object failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
