// At the root of every TypeScript project, defines global settings
// See : https://www.typescriptlang.org/tsconfig/

{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2021",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"outDir": "./dist",
		"baseUrl": ".",
		"strict": true
	},
	"include": ["src/**/*", "schema.ts"]
}