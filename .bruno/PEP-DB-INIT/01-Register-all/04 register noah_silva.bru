meta {
  name: register noah_silva
  type: http
  seq: 7
}

post {
  url: https://pep.localhost:8443/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "noah_silva",
    "email": "noah.silva@example.com",
    "h_password": "Noah2024!"
  }
}

script:post-response {
  const json = res.getBody();
  
  if (res.getStatus() !== 201)
    throw new Error(`register noah_silva failed: ${res.getStatus()} ${JSON.stringify(json)}`);
  
  bru.setEnvVar('u4_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
