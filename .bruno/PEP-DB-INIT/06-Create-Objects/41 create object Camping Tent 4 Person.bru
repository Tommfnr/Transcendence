meta {
  name: create object Camping Tent 4 Person
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_token}}
}

body:json {
  {
    "name": "Camping Tent 4 Person",
    "type": "Outdoor & Recreation",
    "description": "Waterproof 4-person dome tent, easy to pitch.",
    "condition": "worn",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object Camping Tent 4 Person failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
