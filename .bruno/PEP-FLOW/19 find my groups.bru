meta {
  name: 19 find my groups
  type: http
  seq: 19
}

get {
  url: https://pep.localhost:8443/api/groups/my
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find my groups failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
