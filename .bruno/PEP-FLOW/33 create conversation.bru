meta {
  name: 33 create conversation
  type: http
  seq: 33
}

post {
  url: https://pep.localhost:8443/api/chats
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "recipientId": {{u2_id}},
  "content": "Hi, about the lending request..."
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 201)
    throw new Error(`create conversation failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('conversation_id', json.conversation.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
