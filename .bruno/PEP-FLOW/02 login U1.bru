meta {
  name: 02 login U1
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
  "identifier": "flowuser1",
  "password": "Flow@123456"
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 200)
    throw new Error(`login U1 failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('u1_access_token', json.access_token);

const from = new Date(Date.now() + 24 * 60 * 60 * 1000);
const to = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);
bru.setEnvVar('date_from', from.toISOString());
bru.setEnvVar('date_to', to.toISOString());
}

settings {
  encodeUrl: true
  timeout: 0
}
