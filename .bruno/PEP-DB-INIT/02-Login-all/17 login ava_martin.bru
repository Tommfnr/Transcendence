meta {
  name: login ava_martin
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "ava_martin",
    "password": "AvaM2024!"
  }
}

script:post-response {
  const json = res.getBody();
  
  if (res.getStatus() !== 200)
    throw new Error(`login ava_martin failed: ${res.getStatus()} ${JSON.stringify(json)}`);
  
  bru.setEnvVar('u5_token', json.access_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
