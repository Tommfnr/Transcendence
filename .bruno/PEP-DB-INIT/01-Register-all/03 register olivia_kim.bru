meta {
  name: register olivia_kim
  type: http
  seq: 8
}

post {
  url: https://pep.localhost:8443/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "olivia_kim",
    "email": "olivia.kim@example.com",
    "h_password": "Olivia2024!"
  }
}

script:post-response {
  const json = res.getBody();
  
  if (res.getStatus() !== 201)
    throw new Error(`register olivia_kim failed: ${res.getStatus()} ${JSON.stringify(json)}`);
  
  bru.setEnvVar('u3_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
