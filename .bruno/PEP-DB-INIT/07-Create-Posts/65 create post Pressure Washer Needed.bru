meta {
  name: create post Pressure Washer Needed
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u4_token}}
}

body:json {
  {
    "title": "Pressure Washer Needed",
    "objectType": "Tools",
    "description": "Looking for a pressure washer to clean the driveway.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{family_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Pressure Washer Needed failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
