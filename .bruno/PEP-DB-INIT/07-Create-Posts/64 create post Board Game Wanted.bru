meta {
  name: create post Board Game Wanted
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u3_token}}
}

body:json {
  {
    "title": "Board Game Wanted",
    "objectType": "Media",
    "description": "Borrowing a board game for family game night on Saturday.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{family_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Board Game Wanted failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
