meta {
  name: 31 update post
  type: http
  seq: 31
}

put {
  url: https://pep.localhost:8443/api/posts/{{post_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "title": "Flow post updated",
  "objectType": "Tools",
  "description": "Updated by the flow",
  "status": "open",
  "fromDate": "{{date_from}}",
  "toDate": "{{date_to}}",
  "groupIds": [{{group_id}}]
  }
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`update post failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
