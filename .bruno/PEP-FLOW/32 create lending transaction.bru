meta {
  name: 32 create lending transaction
  type: http
  seq: 32
}

post {
  url: https://pep.localhost:8443/api/lending
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_access_token}}
}

body:json {
  {
  "objectId": {{object_id}},
  "lendedFrom": "{{date_from}}",
  "lendedTo": "{{date_to}}",
  "message": "Can I borrow this?"
  }
}

script:post-response {
if (res.getStatus() !== 201)
    throw new Error(`create lending transaction failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
