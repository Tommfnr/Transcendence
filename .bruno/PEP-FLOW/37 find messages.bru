meta {
  name: 37 find messages
  type: http
  seq: 37
}

get {
  url: https://pep.localhost:8443/api/chats/{{conversation_id}}/messages
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find messages failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
