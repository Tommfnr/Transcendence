meta {
  name: 11 create object
  type: http
  seq: 11
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "name": "FlowDrill",
  "type": "Tools",
  "description": "Test object created by the flow",
  "condition": "good",
  "isAvailable": true
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 201)
    throw new Error(`create object failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('object_id', json[0].id);
}

settings {
  encodeUrl: true
  timeout: 0
}
