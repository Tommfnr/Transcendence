meta {
  name: 28 find my posts
  type: http
  seq: 28
}

get {
  url: https://pep.localhost:8443/api/posts/my
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find my posts failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
