meta {
  name: 09 find user by username
  type: http
  seq: 9
}

get {
  url: https://pep.localhost:8443/api/users/username/flowuser2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find user by username failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
