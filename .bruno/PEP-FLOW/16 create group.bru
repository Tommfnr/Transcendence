meta {
  name: 16 create group
  type: http
  seq: 16
}

post {
  url: https://pep.localhost:8443/api/groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "name": "FlowGroup",
  "description": "Test group created by the flow"
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 201)
    throw new Error(`create group failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('group_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
