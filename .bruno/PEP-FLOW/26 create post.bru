meta {
  name: 26 create post
  type: http
  seq: 26
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "title": "Flow post",
  "objectType": "Tools",
  "description": "Test post created by the flow",
  "fromDate": "{{date_from}}",
  "toDate": "{{date_to}}",
  "groupIds": [{{group_id}}]
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 201)
    throw new Error(`create post failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('post_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
