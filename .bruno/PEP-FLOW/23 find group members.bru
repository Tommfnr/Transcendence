meta {
  name: 23 find group members
  type: http
  seq: 23
}

get {
  url: https://pep.localhost:8443/api/groups/{{group_id}}/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find group members failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
