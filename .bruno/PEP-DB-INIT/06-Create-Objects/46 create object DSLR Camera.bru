meta {
  name: create object DSLR Camera
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u5_token}}
}

body:json {
  {
    "name": "DSLR Camera",
    "type": "Electronics",
    "description": "Entry-level DSLR with an 18-55mm kit lens.",
    "condition": "new",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object DSLR Camera failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
