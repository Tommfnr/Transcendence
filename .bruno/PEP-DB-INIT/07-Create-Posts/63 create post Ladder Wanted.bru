meta {
  name: create post Ladder Wanted
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u2_token}}
}

body:json {
  {
    "title": "Ladder Wanted",
    "objectType": "Tools",
    "description": "Need a ladder to clean out the gutters before it rains.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{family_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Ladder Wanted failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
