meta {
  name: create object Kayak
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u4_token}}
}

body:json {
  {
    "name": "Kayak",
    "type": "Outdoor & Recreation",
    "description": "Single-seat recreational kayak with paddle included.",
    "condition": "good",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object Kayak failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
