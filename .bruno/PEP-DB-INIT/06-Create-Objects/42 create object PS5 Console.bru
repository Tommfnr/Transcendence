meta {
  name: create object PS5 Console
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u3_token}}
}

body:json {
  {
    "name": "PS5 Console",
    "type": "Electronics",
    "description": "PlayStation 5 console with one controller.",
    "condition": "good",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object PS5 Console failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
