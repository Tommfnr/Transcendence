meta {
  name: 06 login U2
  type: http
  seq: 6
}

post {
  url: https://pep.localhost:8443/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
  "identifier": "flowuser2",
  "password": "Flow@123456"
  }
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 200)
    throw new Error(`login U2 failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('u2_access_token', json.access_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
