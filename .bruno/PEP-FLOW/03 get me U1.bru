meta {
  name: 03 get me U1
  type: http
  seq: 3
}

get {
  url: https://pep.localhost:8443/api/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
const json = res.getBody();

if (res.getStatus() !== 200)
    throw new Error(`get me U1 failed: ${res.getStatus()} ${JSON.stringify(json)}`);

bru.setEnvVar('u1_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
