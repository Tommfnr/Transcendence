meta {
  name: 15 update object
  type: http
  seq: 15
}

put {
  url: https://pep.localhost:8443/api/objects/{{object_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

body:json {
  {
  "name": "FlowDrill",
  "type": "Tools",
  "description": "Updated by the flow",
  "condition": "worn",
  "isAvailable": true
  }
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`update object failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
