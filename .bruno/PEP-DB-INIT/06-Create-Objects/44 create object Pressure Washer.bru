meta {
  name: create object Pressure Washer
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u4_token}}
}

body:json {
  {
    "name": "Pressure Washer",
    "type": "Tools",
    "description": "Electric pressure washer, good for driveways and patios.",
    "condition": "worn",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object Pressure Washer failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
