meta {
  name: 30 find post groups
  type: http
  seq: 30
}

get {
  url: https://pep.localhost:8443/api/posts/{{post_id}}/groups
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`find post groups failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
