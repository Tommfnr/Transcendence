meta {
  name: add noah_silva to Family
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/groups/{{family_id}}/members/{{u4_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_token}}
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`add noah_silva to Family failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
