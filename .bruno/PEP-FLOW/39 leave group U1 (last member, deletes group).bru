meta {
  name: 39 leave group U1 (last member, deletes group)
  type: http
  seq: 39
}

delete {
  url: https://pep.localhost:8443/api/groups/{{group_id}}/leave
  body: none
  auth: bearer
}

auth:bearer {
  token: {{u1_access_token}}
}

script:post-response {
if (res.getStatus() !== 200)
    throw new Error(`leave group U1 failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
