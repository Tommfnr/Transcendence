{
	"name": "@pep/shared",
	"version": "0.1.0",
	"private": true,
	"type": "commonjs",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist",
		"prepare": "npm run build",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.0.0",
		"express": "^5.0.0",
		"reflect-metadata": "^0.2.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"dependencies": {
		"jsonwebtoken": "^9.0.2",
		"nestjs-zod": "^5.4.0"
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.29",
		"@nestjs/core": "^11.1.29",
		"@nestjs/testing": "^11.1.29",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/node": "^20.0.0",
		"jest": "^29.7.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.0.0",
		"zod": "^4.6.7"
	}
}
