meta {
  name: create post Trailer Needed
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u3_token}}
}

body:json {
  {
    "title": "Trailer Needed",
    "objectType": "Vehicles",
    "description": "Need a small trailer to haul yard waste to the dump this weekend.",
    "fromDate": "{{date_from}}",
    "toDate": "{{date_to}}",
    "groupIds": [{{neighbors_id}}]
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create post Trailer Needed failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
