meta {
  name: create group Friends
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u5_token}}
}

body:json {
  {
    "name": "Friends",
    "description": "Lending and borrowing between close friends."
  }
}

script:post-response {
  const json = res.getBody();
  
  if (res.getStatus() !== 201)
    throw new Error(`create group Friends failed: ${res.getStatus()} ${JSON.stringify(json)}`);
  
  bru.setEnvVar('friends_id', json.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
