meta {
  name: create object Cordless Drill
  type: http
  seq: 2
}

post {
  url: https://pep.localhost:8443/api/objects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{u1_token}}
}

body:json {
  {
    "name": "Cordless Drill",
    "type": "Tools",
    "description": "18V cordless drill with two batteries and a charger.",
    "condition": "good",
    "isAvailable": true
  }
}

script:post-response {
  if (res.getStatus() !== 201)
    throw new Error(`create object Cordless Drill failed: ${res.getStatus()} ${JSON.stringify(res.getBody())}`);
}

settings {
  encodeUrl: true
  timeout: 0
}
