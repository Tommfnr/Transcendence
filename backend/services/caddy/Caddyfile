http://pep.localhost {
	redir https://pep.localhost:8443{uri} permanent
}

pep.localhost {

	tls internal

	@internalRoutes path /internal /internal/*
	handle @internalRoutes {
		respond 404
	}

	# This will handle correct reverse proxying to the backend
	@authRoutes path /api/auth /api/auth/*
	handle @authRoutes {
		reverse_proxy auth:3000
	}

	@usersRoutes path /api/users /api/users/*
	handle @usersRoutes {
		reverse_proxy users:3000
	}

	@objectsRoutes path /api/objects /api/objects/*
	handle @objectsRoutes {
		reverse_proxy objects:3000
	}

	@groupsRoutes path /api/groups /api/groups/*
	handle @groupsRoutes {
		reverse_proxy groups:3000
	}

	@lendingRoutes path /api/lending /api/lending/*
	handle @lendingRoutes {
		reverse_proxy lending:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# This will handle all the rest of the routes to the frontend
	handle {
		reverse_proxy frontend:4200
	}
}